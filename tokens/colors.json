{
  "$about": "HeyOz colour tokens. Source of truth. Dark mode. Primitives are generated from the recipe below: every ramp has the same 12 steps, and a step has the same lightness in every ramp. Semantic tokens reference ramp steps. Edit here, then run the token build.",
  "$mode": "dark",
  "primitive": {
    "$about": "12-step scale, modelled on Radix Colors. Step jobs: 1-2 app backgrounds, 3-5 component backgrounds (rest, hover, active), 6-8 borders, 9 solid colour, 10 solid hover, 11 low-contrast text, 12 high-contrast text. Colour ramp chroma = ramp chroma x step factor, reduced only where sRGB cannot show it. Status ramps use \"max\": the most chroma their hue can reach at step 9, so each status colour is as vivid as it can be at the same lightness. Orange is fixed to the brand colour. Gray chroma is constant.",
    "steps": {
      "lightness": [0.12, 0.155, 0.19, 0.225, 0.26, 0.295, 0.33, 0.365, 0.6536, 0.7, 0.8, 0.95],
      "chroma": [0.1, 0.14, 0.2, 0.26, 0.32, 0.38, 0.46, 0.58, 1, 0.92, 0.62, 0.22],
      "$about": "Steps 1-8 rise by an even +0.035 L (the background-to-border range). Steps 9-12 are the solid and text range: 9 is pinned to the brand orange."
    },
    "white": [1, 0, 0],
    "ramps": {
      "gray": {
        "hue": 55,
        "chroma": 0.004,
        "constant": true
      },
      "orange": {
        "hue": 33.98,
        "chroma": 0.2347,
        "$note": "Brand. Step 9 is exactly #FF3D01."
      },
      "green": {
        "hue": 155,
        "chroma": "max"
      },
      "amber": {
        "hue": 75,
        "chroma": "max"
      },
      "red": {
        "hue": 25,
        "chroma": "max"
      },
      "blue": {
        "hue": 260,
        "chroma": "max"
      }
    }
  },
